# Client build metadata
VITE_GODOY_RELEASE_VERSION=v0.1.0-alpha
VITE_GODOY_RELEASE_CHANNEL=Public Alpha

# Public client WebSocket endpoint.
# Local development can omit this and use ws://127.0.0.1:8787.
# Public deployments should set this to the hosted server, for example:
# VITE_GODOY_WS_URL=wss://godoy-engine-server.example.com
VITE_GODOY_WS_URL=

# Optional public feedback form or issue tracker URL.
VITE_GODOY_FEEDBACK_URL=

# Dedicated server runtime
GODOY_MULTIPLAYER_HOST=0.0.0.0
GODOY_MULTIPLAYER_PORT=8787
GODOY_SERVER_TICK_RATE=20
GODOY_DEFAULT_WORLD_ID=public-alpha
GODOY_PERSIST_WORLDS=1
GODOY_SERVER_DATA_DIR=server-data
